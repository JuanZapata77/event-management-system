# Database connection option 1: Full Connection String (recommended for Neon, Supabase, Render, Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Database connection option 2: Individual variables
DB_USER=postgres
DB_HOST=localhost
DB_NAME=event_management
DB_PASSWORD=your_password
DB_PORT=5432

# SSL options for cloud databases (Neon, Supabase, Render)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false # Defaults to false for cloud compatibility; set to true if providing DB_CA_CERT
# DB_CA_CERT=

# Server & Security
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app
